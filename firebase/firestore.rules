rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowedAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/allowedAdmins/$(request.auth.token.email));
    }

    match /allowedAdmins/{email} {
      allow get: if isSignedIn() && email == request.auth.token.email;
      allow list: if isAllowedAdmin();
      allow create, update, delete: if isAllowedAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if isAllowedAdmin() || true;
      allow write: if isAllowedAdmin();
    }

    match /campaignTabs/{tabId} {
      allow read: if isAllowedAdmin() || true;
      allow write: if isAllowedAdmin();
    }

    match /guideSections/{sectionId} {
      allow read: if isAllowedAdmin() || true;
      allow write: if isAllowedAdmin();
    }

    match /guideItems/{itemId} {
      allow read: if isAllowedAdmin() || resource.data.isDeleted != true;
      allow write: if isAllowedAdmin();
    }

    match /mediaAssets/{mediaId} {
      allow read: if isAllowedAdmin() || true;
      allow write: if isAllowedAdmin();
    }

    match /publicGuides/{token} {
      allow get: if true;
      allow list: if isAllowedAdmin();
      allow create, update, delete: if isAllowedAdmin();
    }

    match /glossaryGlobal/{docId} {
      allow read, write: if isAllowedAdmin();
    }

    match /systemTemplates/{docId} {
      allow read: if true;
      allow write: if isAllowedAdmin();
    }
  }
}
